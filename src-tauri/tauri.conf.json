{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebP Converter",
  "version": "1.0.0",
  "identifier": "com.webp-tool.converter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "WebP Converter",
        "width": 900,
        "height": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "WebP 图片转换工具 - 支持 PNG、JPG、JPEG 转为 WebP。© 2025 WebP Tool Contributors.",
    "shortDescription": "WebP 图片转换工具",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "externalBin": [],
    "copyright": "© 2025 WebP Tool Contributors. All rights reserved.",
    "category": "DeveloperTool"
  },
  "plugins": {}
}
